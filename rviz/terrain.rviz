Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.5
    Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Ground grid
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: base_link
    Value: true
  - Alpha: 0.8
    Autocompute Intensity Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: true
    Name: VLP-16 points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /velodyne_points
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.8
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: ZED colored points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /zed/zed_node/point_cloud/cloud_registered
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Terrain hazards
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain/hazards
    Use Timestamp: false
    Value: false
  - Alpha: 1
    Class: rviz_default_plugins/GridCells
    Color: 255; 200; 0
    Enabled: true
    Name: Up step cells
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain/up_cells
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/GridCells
    Color: 255; 0; 0
    Enabled: true
    Name: Drop off cells
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain/drop_cells
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Up steps
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain/up_steps
    Use Timestamp: false
    Value: false
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Drop offs
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain/drop_offs
    Use Timestamp: false
    Value: false
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 20
  Name: root
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 2.5
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.0
    Saved: null

Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.5
    Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Ground grid
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: sim_base_link
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Scene geometry
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/scene_markers
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/robot_description
    Enabled: true
    Name: CAT robot (URDF)
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Alpha: 0.8
    Autocompute Intensity Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: true
    Name: VLP-16 points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/velodyne_points
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.8
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: false
    Name: ZED colored points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /zed/zed_node/point_cloud/cloud_registered
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Terrain hazards
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/terrain/hazards
    Use Timestamp: false
    Value: false
  - Alpha: 1
    Class: rviz_default_plugins/GridCells
    Color: 255; 200; 0
    Enabled: true
    Name: Up step cells
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/terrain/up_cells
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/GridCells
    Color: 255; 0; 0
    Enabled: true
    Name: Drop off cells
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/terrain/drop_cells
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Up steps
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/terrain/up_steps
    Use Timestamp: false
    Value: false
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: false
    Name: Drop offs
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sim/terrain/drop_offs
    Use Timestamp: false
    Value: false
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: sim_base_link
    Frame Rate: 20
  Name: root
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: sim_base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.4
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Width: 1280
  X: 50
  Y: 50

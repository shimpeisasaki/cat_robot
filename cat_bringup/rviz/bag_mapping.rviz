Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Occupancy map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR scan
      Enabled: true
      Value: true
      Topic:
        Value: /scan
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry
      Enabled: true
      Value: true
      Topic:
        Value: /wheel/odom
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Keep: 5000
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 230; 140; 20
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.015
        Head Length: 0.06
        Head Radius: 0.035
    - Class: rviz_default_plugins/Odometry
      Name: EKF odometry
      Enabled: true
      Value: true
      Topic:
        Value: /odom
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Keep: 5000
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 40; 120; 255
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.015
        Head Length: 0.06
        Head Radius: 0.035
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 60
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1200
  Height: 850

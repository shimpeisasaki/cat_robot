Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: VLP16_B
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: true
    Name: VLP-16 points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /velodyne_points
    Use Fixed Frame: true
    Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: VLP16_B
    Frame Rate: 30
  Name: root
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Target Frame: VLP16_B
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
    Saved: null

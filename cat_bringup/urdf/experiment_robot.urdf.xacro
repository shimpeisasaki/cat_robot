<?xml version="1.0"?>
<robot name="experiment_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_zed" default="true"/>
  <xacro:arg name="rplidar_x" default="0.03319"/>
  <xacro:arg name="rplidar_y" default="0"/>
  <xacro:arg name="rplidar_z" default="0.24883"/>
  <xacro:arg name="rplidar_yaw" default="3.141592653589793"/>
  <xacro:arg name="rplidar_roll" default="0"/>
  <!-- Measurements are expressed from the drive-axle midpoint at ground level. -->
  <xacro:property name="wheel_radius" value="0.050"/>
  <xacro:property name="wheel_width" value="0.040"/>
  <xacro:property name="track_width" value="0.208"/>

  <material name="body_blue"><color rgba="0.10 0.35 0.80 1.0"/></material>
  <material name="wheel_black"><color rgba="0.04 0.04 0.04 1.0"/></material>
  <material name="antenna_white"><color rgba="0.90 0.90 0.90 1.0"/></material>
  <material name="safety_red"><color rgba="1.0 0.10 0.10 0.18"/></material>

  <link name="base_link"/>

  <link name="chassis_link">
    <visual>
      <!-- Body thickness 0.140; underside at z=0.050, top at z=0.190. -->
      <origin xyz="-0.1325 0 0.120" rpy="0 0 0"/>
      <geometry><box size="0.375 0.300 0.140"/></geometry>
      <material name="body_blue"/>
    </visual>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/><child link="chassis_link"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <!-- The wheel link origin is its axle center. -->
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
    </link>
    <joint name="${side}_wheel_joint" type="fixed">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${track_width/2}"/>
  <xacro:drive_wheel side="right" y="${-track_width/2}"/>

  <!-- Swivel-axis reference at the measured mounting height.
       Fixed joints show the nominal trailing pose; this is not a caster simulation. -->
  <link name="caster_link"/>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/>
    <origin xyz="-0.345 0 0.125" rpy="0 0 0"/>
  </joint>
  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="caster_link"/><child link="caster_wheel_link"/>
    <!-- 35 mm trail; wheel axle at ground height + radius (50 mm). -->
    <origin xyz="-0.035 0 -0.075" rpy="0 0 0"/>
  </joint>

  <!-- Provisional Nav2 footprint: +0.075/-0.460 x +/-0.170 m. -->
  <link name="safety_footprint_link">
    <visual>
      <origin xyz="-0.1925 0 0.006" rpy="0 0 0"/>
      <geometry><box size="0.535 0.340 0.012"/></geometry>
      <material name="safety_red"/>
    </visual>
  </link>
  <joint name="safety_footprint_joint" type="fixed">
    <parent link="base_link"/><child link="safety_footprint_link"/>
  </joint>

  <!-- RPLIDAR S1 mounting positions; /scan uses the selected frame only. -->
  <link name="RPLIDAR_F"/>
  <joint name="RPLIDAR_F_joint" type="fixed">
    <parent link="base_link"/><child link="RPLIDAR_F"/>
    <origin xyz="0.03319 0 0.24883" rpy="0 0 ${pi}"/>
  </joint>
  <link name="RPLIDAR_B"/>
  <joint name="RPLIDAR_B_joint" type="fixed">
    <parent link="base_link"/><child link="RPLIDAR_B"/>
    <origin xyz="-0.3095 0 0.49735" rpy="${pi} 0 ${pi/2}"/>
  </joint>
  <link name="RPLIDAR_custom"/>
  <joint name="RPLIDAR_custom_joint" type="fixed">
    <parent link="base_link"/><child link="RPLIDAR_custom"/>
    <origin xyz="$(arg rplidar_x) $(arg rplidar_y) $(arg rplidar_z)"
            rpy="$(arg rplidar_roll) 0 $(arg rplidar_yaw)"/>
  </joint>

  <!-- VLP-16 front and rear mounting positions. -->
  <link name="VLP16_F"/>
  <joint name="VLP16_F_joint" type="fixed">
    <parent link="base_link"/><child link="VLP16_F"/>
    <origin xyz="0.0186 0 0.207" rpy="0 ${7*pi/180} 0"/>
  </joint>
  <link name="VLP16_B"/>
  <joint name="VLP16_B_joint" type="fixed">
    <parent link="base_link"/><child link="VLP16_B"/>
    <origin xyz="-0.347981 0 0.515158" rpy="${(180-20)*pi/180} 0 ${pi/2}"/>
  </joint>

  <!-- Camera mount: 285 mm behind the axle, centered, 550 mm above ground.
       Positive pitch tips the forward-facing camera down by 12 degrees. -->
  <xacro:if value="$(arg use_zed)">
    <xacro:include filename="$(find zed_description)/urdf/zed_macro.urdf.xacro"/>
    <xacro:zed_camera name="zed" model="zedm" enable_gnss="false">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>
    <joint name="zed_mount_joint" type="fixed">
      <parent link="base_link"/><child link="zed_camera_link"/>
      <origin xyz="-0.285 0 0.550" rpy="0 ${12*pi/180} 0"/>
    </joint>
  </xacro:if>

  <!-- GNSS link origin is the user-provided antenna reference point. -->
  <link name="gnss_antenna_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Ellipsoid: diameter 0.160, height 0.050; reference at its center. -->
      <geometry><mesh filename="package://cat_bringup/meshes/antenna.stl"/></geometry>
      <material name="antenna_white"/>
    </visual>
  </link>
  <joint name="gnss_antenna_joint" type="fixed">
    <parent link="base_link"/><child link="gnss_antenna_link"/>
    <origin xyz="-0.310 0 0.610" rpy="0 0 0"/>
  </joint>
</robot>

#!/usr/bin/env python3
"""Own ZED launch descendants and recover VIO only after stopping all of them."""
import argparse
from contextlib import contextmanager
import fcntl
import os
from pathlib import Path
import signal
import subprocess
from tempfile import TemporaryDirectory
import time
from typing import Iterator


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False


def stop_group(process):
    """Bound cleanup below the parent launch's default five-second timeout.

    Signal the group even if ros2 launch has already exited: its container
    may still be running and retaining the camera and ROS service names.
    """
    for sig, timeout in ((signal.SIGINT, 2.), (signal.SIGTERM, 1.),
                         (signal.SIGKILL, .5)):
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            break
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            process.poll()  # Reap the launch parent if it has exited.
            if not group_alive(process.pid):
                return
            time.sleep(.02)
    process.poll()


@contextmanager
def resolved_config(path: str) -> Iterator[str]:
    """Expand a CAT common/profile pair into one override for the child's lifetime."""
    import yaml
    profile = Path(path)
    config = yaml.safe_load(profile.read_text(encoding='utf-8'))
    common = config.pop('cat_zed_common', None)
    if common is None:
        # Existing standalone custom ROS files keep their exact path and contents.
        yield path
        return
    merged = yaml.safe_load((profile.parent / common).read_text(encoding='utf-8'))
    parameters = merged['/**']['ros__parameters']
    for section, values in config['/**']['ros__parameters'].items():
        parameters.setdefault(section, {}).update(values)
    with TemporaryDirectory(prefix='cat-zed-config-') as directory:
        effective = Path(directory) / 'override.yaml'
        effective.write_text(yaml.safe_dump(merged), encoding='utf-8')
        yield str(effective)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--serial-number', required=True)
    parser.add_argument('--config', required=True)
    args, ros_args = parser.parse_known_args()
    with resolved_config(args.config) as config_path:
        return supervise(args.serial_number, config_path, ros_args)


def supervise(serial_number: str, config_path: str, ros_args: list[str]) -> int:
    import rclpy
    import yaml
    from nav_msgs.msg import Odometry
    from rclpy.qos import qos_profile_sensor_data

    with open(config_path, encoding='utf-8') as stream:
        config = yaml.safe_load(stream)
    # CAT override files use the wildcard node key.
    vio = config.get('/**', {}).get('ros__parameters', {}).get(
        'pos_tracking', {}).get('pos_tracking_enabled', False)
    # Lock before discovery/spawn so simultaneous CAT launches cannot race.
    lock_path = f'/tmp/cat-zed-{os.getuid()}-{serial_number}.lock'
    with open(lock_path, 'a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print('ZED already owned by another CAT launch', flush=True)
            return 2
        rclpy.init(args=ros_args)
        node = rclpy.create_node('zed_supervisor')
        stopping = False

        def stop(_sig, _frame):
            nonlocal stopping
            stopping = True

        signal.signal(signal.SIGINT, stop)
        signal.signal(signal.SIGTERM, stop)
        process = None
        last_odom = None

        def odom(_msg):
            nonlocal last_odom
            last_odom = time.monotonic()

        if vio:
            node.create_subscription(Odometry, '/zed/zed_node/odom', odom,
                                     qos_profile_sensor_data)
        try:
            deadline = time.monotonic() + 1.
            while not stopping and time.monotonic() < deadline:
                rclpy.spin_once(node, timeout_sec=.05)
            if stopping:
                return 0
            if any(ns == '/zed' and name in ('zed_container', 'zed_node')
                   for name, ns in node.get_node_names_and_namespaces()):
                node.get_logger().error(
                    'Existing /zed container/node detected; stop the previous '
                    'ZED launch before restarting. Refusing duplicate camera ownership.')
                return 2
            command = ['ros2', 'launch', 'zed_wrapper', 'zed_camera.launch.py',
                       'camera_model:=zedm', 'camera_name:=zed', 'node_name:=zed_node',
                       f'serial_number:={serial_number}',
                       'publish_urdf:=false', 'publish_tf:=false',
                       'publish_map_tf:=false', 'publish_imu_tf:=true',
                       'enable_gnss:=false', 'enable_ipc:=false', 'use_sim_time:=false',
                       f'ros_params_override_path:={config_path}']
            process = subprocess.Popen(command, start_new_session=True)
            started = time.monotonic()
            while not stopping:
                code = process.poll()
                if code is not None:
                    return code
                rclpy.spin_once(node, timeout_sec=.1)
                now = time.monotonic()
                if vio and ((last_odom is None and now-started > 60.) or
                            (last_odom is not None and now-last_odom > 10.)):
                    node.get_logger().error(
                        'ZED VIO output missing; stopping the complete wrapper '
                        'process group before respawn. Restart navigation after recovery.')
                    return 1
            return 0
        finally:
            if process is not None:
                stop_group(process)
            node.destroy_node()
            if rclpy.ok():
                rclpy.shutdown()


if __name__ == '__main__':
    raise SystemExit(main())

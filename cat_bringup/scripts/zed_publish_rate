#!/usr/bin/env python3
"""Keep ZED RGB/depth publishing at 10 Hz in manual and freewheel modes."""

import time

import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rcl_interfaces.srv import SetParameters
from std_msgs.msg import String


class ZedPublishRate(Node):
    def __init__(self):
        super().__init__('zed_publish_rate')
        self.status = ''
        self.status_at = 0.0
        self.sent_rate = None
        self.sent_at = 0.0
        self.pending = None
        self.client = self.create_client(SetParameters, '/zed/zed_node/set_parameters')
        self.create_subscription(String, '/base_safety/status', self.on_status, 1)
        self.create_timer(0.2, self.tick)

    def on_status(self, msg):
        self.status = msg.data
        self.status_at = time.monotonic()

    def tick(self):
        now = time.monotonic()
        # These modes are active only after base_safety completes its handover.
        slow_mode = (now - self.status_at < 1.0 and
                     (self.status.startswith('2: MANUAL:') or
                      self.status.startswith('1: FREE:')))
        rate = 10.0 if slow_mode else 30.0
        if self.pending is not None:
            if not self.pending.done():
                return
            try:
                response = self.pending.result()
                if not response.results or not all(result.successful for result in response.results):
                    reasons = ', '.join(result.reason for result in response.results)
                    self.get_logger().warning(f'ZED publish rate update rejected: {reasons}')
                    self.sent_rate = None
            except Exception as exc:
                self.get_logger().warning(f'ZED publish rate update failed: {exc}')
                self.sent_rate = None
            self.pending = None
        # Reapply periodically so a respawned ZED node also receives the manual rate.
        if rate == self.sent_rate and now - self.sent_at < 5.0:
            return
        if not self.client.service_is_ready():
            return
        request = SetParameters.Request()
        request.parameters = [Parameter('general.pub_frame_rate',
                                        value=rate).to_parameter_msg()]
        self.pending = self.client.call_async(request)
        self.sent_rate = rate
        self.sent_at = now
        self.get_logger().info(f'ZED RGB/depth publish rate requested: {rate:g} Hz')


def main():
    rclpy.init()
    node = ZedPublishRate()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()

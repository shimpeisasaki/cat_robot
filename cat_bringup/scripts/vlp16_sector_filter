#!/usr/bin/env python3
"""Mask VLP-16 near returns by vehicle bearing without changing cloud layout."""
import math

import numpy as np
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import PointCloud2, PointField


def mounting_rotation(roll, pitch, yaw):
    cr, sr = math.cos(roll), math.sin(roll)
    cp, sp = math.cos(pitch), math.sin(pitch)
    cy, sy = math.cos(yaw), math.sin(yaw)
    return np.array([
        [cy * cp, cy * sp * sr - sy * cr, cy * sp * cr + sy * sr],
        [sy * cp, sy * sp * sr + cy * cr, sy * sp * cr - cy * sr],
        [-sp, cp * sr, cp * cr],
    ])


def filter_cloud(cloud, rotation, front_angle, front_min, rear_min):
    fields = {field.name: field for field in cloud.fields}
    for name in ('x', 'y', 'z'):
        field = fields.get(name)
        if field is None or field.datatype != PointField.FLOAT32 or field.offset + 4 > cloud.point_step:
            raise ValueError(f'PointCloud2 requires FLOAT32 {name}')
    intensity = fields.get('intensity')
    if intensity is not None and (intensity.datatype != PointField.FLOAT32 or
                                  intensity.offset + 4 > cloud.point_step):
        raise ValueError('PointCloud2 intensity must be FLOAT32')
    if (cloud.row_step < cloud.width * cloud.point_step or
            len(cloud.data) < cloud.height * cloud.row_step):
        raise ValueError('Invalid PointCloud2 data layout')

    data = bytearray(cloud.data)
    dtype = np.dtype('>f4' if cloud.is_bigendian else '<f4')

    def view(name):
        return np.ndarray((cloud.height, cloud.width), dtype=dtype,
                          buffer=data, offset=fields[name].offset,
                          strides=(cloud.row_step, cloud.point_step))

    x, y, z = view('x'), view('y'), view('z')
    valid = np.isfinite(x) & np.isfinite(y) & np.isfinite(z)
    # Rotate the direction from the LiDAR origin; translation does not affect
    # the sector bearing or the range measured from that origin.
    vehicle_x = rotation[0, 0] * x + rotation[0, 1] * y + rotation[0, 2] * z
    vehicle_y = rotation[1, 0] * x + rotation[1, 1] * y + rotation[1, 2] * z
    front = np.abs(np.arctan2(vehicle_y, vehicle_x)) <= front_angle / 2 + 1e-9
    threshold = np.where(front, front_min, rear_min)
    distance = np.sqrt(x * x + y * y + z * z)
    masked = valid & (distance < threshold - 1e-7)
    count = int(np.count_nonzero(masked))
    if count:
        x[masked] = np.nan
        y[masked] = np.nan
        z[masked] = np.nan
        if intensity is not None:
            view('intensity')[masked] = np.nan
        cloud.data = bytes(data)
        cloud.is_dense = False
    return cloud, count


class Vlp16SectorFilter(Node):
    def __init__(self):
        super().__init__('vlp16_sector_filter')
        self.frame = self.declare_parameter('scan_frame', 'vlp16').value
        angles = [float(self.declare_parameter(name, default).value) for name, default in (
            ('mounting_roll', 0.0), ('mounting_pitch', math.radians(7)),
            ('mounting_yaw', 0.0))]
        self.front_angle = math.radians(float(
            self.declare_parameter('front_angle_deg', 270.0).value))
        self.front_min = float(self.declare_parameter('front_min_range', 0.1).value)
        self.rear_min = float(self.declare_parameter('rear_min_range', 0.6).value)
        if (not all(math.isfinite(v) for v in angles + [self.front_angle,
                self.front_min, self.rear_min]) or
                not 0 < self.front_angle <= 2 * math.pi or
                min(self.front_min, self.rear_min) < 0):
            raise ValueError('Invalid VLP-16 sector mask parameters')
        self.rotation = mounting_rotation(*angles)
        self.pub = self.create_publisher(PointCloud2, '/velodyne_points', 10)
        self.sub = self.create_subscription(
            PointCloud2, '/velodyne_points_raw', self.receive, 10)
        self.get_logger().info(
            f'Vehicle front {math.degrees(self.front_angle):.0f} deg: '
            f'{self.front_min:.3f} m; rear: {self.rear_min:.3f} m')

    def receive(self, cloud):
        if cloud.header.frame_id != self.frame:
            self.get_logger().error('Unexpected cloud frame; refusing incorrect angular mask',
                                    throttle_duration_sec=5.0)
            return
        try:
            filtered, _ = filter_cloud(cloud, self.rotation, self.front_angle,
                                       self.front_min, self.rear_min)
        except ValueError as exc:
            self.get_logger().error(str(exc), throttle_duration_sec=5.0)
            return
        self.pub.publish(filtered)


def main():
    rclpy.init()
    node = Vlp16SectorFilter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()

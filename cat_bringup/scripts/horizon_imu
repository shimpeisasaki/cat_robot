#!/usr/bin/env python3
"""Apply stationary gyro bias and convert raw Horizon acceleration to SI."""
import copy
import math
import signal

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.signals import SignalHandlerOptions
from sensor_msgs.msg import Imu


def correct_imu(raw, bias, gyro_variance, acceleration_variance):
    result = copy.deepcopy(raw)
    for axis, offset in zip(('x', 'y', 'z'), bias):
        setattr(result.angular_velocity, axis, getattr(raw.angular_velocity, axis) - offset)
        setattr(result.linear_acceleration, axis, getattr(raw.linear_acceleration, axis) * 9.80665)
    # Gravity is retained. Neither absolute orientation nor accel bias was calibrated.
    result.orientation_covariance = [-1.0] + [0.0] * 8
    result.angular_velocity_covariance = [0.0] * 9
    result.linear_acceleration_covariance = [0.0] * 9
    for i in range(3):
        result.angular_velocity_covariance[4 * i] = gyro_variance[i]
        result.linear_acceleration_covariance[4 * i] = acceleration_variance[i]
    return result


class HorizonImu(Node):
    def __init__(self):
        super().__init__('horizon_imu')
        self.bias = self.declare_parameter('gyro_bias_rad_s', [0.0] * 3).value
        self.gyro_variance = self.declare_parameter('gyro_variance', [0.0004] * 3).value
        self.acceleration_variance = self.declare_parameter('acceleration_variance', [0.01] * 3).value
        for values in (self.bias, self.gyro_variance, self.acceleration_variance):
            if len(values) != 3 or not all(math.isfinite(v) for v in values):
                raise ValueError('IMU calibration requires three finite values per parameter')
        if any(v <= 0 for v in (*self.gyro_variance, *self.acceleration_variance)):
            raise ValueError('IMU variances must be positive')
        self.pub = self.create_publisher(Imu, '/livox/imu', qos_profile_sensor_data)
        self.sub = self.create_subscription(
            Imu, '/livox/imu_raw', self.receive, qos_profile_sensor_data)

    def receive(self, raw):
        values = (raw.angular_velocity.x, raw.angular_velocity.y, raw.angular_velocity.z,
                  raw.linear_acceleration.x, raw.linear_acceleration.y, raw.linear_acceleration.z)
        if all(math.isfinite(v) for v in values):
            self.pub.publish(correct_imu(raw, self.bias, self.gyro_variance,
                                         self.acceleration_variance))


def main():
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)

    def stop(signum, frame):
        # Launch and the terminal may both signal the process. Let cleanup finish.
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        raise KeyboardInterrupt

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    node = HorizonImu()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()

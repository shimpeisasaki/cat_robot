#!/usr/bin/env python3
"""Exclusive command selection with a zero-output handover via the smoother."""
import math
import time

import rclpy
from rclpy.node import Node
from rclpy.clock import Clock, ClockType
from rclpy.qos import qos_profile_sensor_data
from geometry_msgs.msg import Twist
from sensor_msgs.msg import Joy
from std_msgs.msg import UInt8, UInt8MultiArray, String
from std_srvs.srv import Trigger


class CommandMux(Node):
    def __init__(self):
        super().__init__('command_mux')
        self.joystick = self.declare_parameter('enable_joystick', True).value
        self.source = None
        self.pending = None
        self.mode = 0
        self.commands = {}
        self.buttons = []
        self.joy_time = -math.inf
        self.smooth_time = -math.inf
        self.smoothed = Twist()
        self.switch_time = math.inf
        self.accept_after = math.inf
        self.last_tick = time.monotonic()
        self.zero_samples = 0
        self.motor_time = -math.inf
        self.motors_online = False
        self.target = self.create_publisher(Twist, '/cmd_vel_selected', 1)
        self.output = self.create_publisher(Twist, '/cmd_vel_safe', 1)
        # Existing driver safety-lease interface; no dependency on Nav2 nodes.
        self.lease = self.create_publisher(UInt8, '/navigation_safety/mode', 1)
        self.status = self.create_publisher(String, '~/status', 1)
        for source, topic in [('manual', '/cmd_vel_teleop'), ('external', '/cmd_vel')]:
            self.create_subscription(Twist, topic,
                                     lambda msg, s=source: self.command(s, msg), 1)
        self.create_subscription(Twist, '/cmd_vel_smoothed', self.smooth, 1)
        self.create_subscription(Joy, '/joy', self.joy, qos_profile_sensor_data)
        self.create_subscription(UInt8MultiArray, '/ddsm115/online_id',
                                 self.online, qos_profile_sensor_data)
        for name in ['manual', 'external', 'brake', 'free']:
            self.create_service(Trigger, '~/' + name,
                                lambda req, res, n=name: self.service(n, res))
        self.create_timer(1. / 30., self.tick,
                          clock=Clock(clock_type=ClockType.STEADY_TIME))
        if not self.joystick:
            self.request('external')

    @staticmethod
    def valid(msg):
        values = [msg.linear.x, msg.linear.y, msg.linear.z,
                  msg.angular.x, msg.angular.y, msg.angular.z]
        return (all(math.isfinite(v) for v in values) and
                abs(msg.linear.x) <= 2. and abs(msg.angular.z) <= 3. and
                all(abs(v) < 1e-6 for v in
                    [msg.linear.y, msg.linear.z, msg.angular.x, msg.angular.y]))

    def online(self, msg):
        self.motor_time = time.monotonic()
        self.motors_online = 1 in msg.data and 2 in msg.data

    def command(self, source, msg):
        if self.valid(msg):
            self.commands[source] = (time.monotonic(), msg)
        elif source == self.source:
            self.stop(0)

    def smooth(self, msg):
        if not self.valid(msg):
            self.stop(0)
            return
        self.smoothed = msg
        self.smooth_time = time.monotonic()
        zero = abs(msg.linear.x) < 1e-6 and abs(msg.angular.z) < 1e-6
        self.zero_samples = self.zero_samples + 1 if zero else 0

    def stop(self, mode):
        self.mode = mode
        self.source = self.pending = None
        self.commands.clear()
        self.target.publish(Twist())
        self.output.publish(Twist())
        self.lease.publish(UInt8(data=mode))

    def request(self, source):
        if self.buttons and (self.buttons[1] or self.buttons[3]):
            return
        if source == self.source and self.pending is None:
            return
        # Keep drive enabled while the smoother ramps down. No switch brake.
        self.pending = source
        self.switch_time = time.monotonic()
        self.zero_samples = 0
        self.commands.clear()

    def joy(self, msg):
        if len(msg.buttons) < 4:
            return
        self.joy_time = time.monotonic()
        old = self.buttons
        self.buttons = list(msg.buttons)
        pressed = lambda i: self.buttons[i] and (not old or not old[i])
        if pressed(1):
            self.stop(0)
        elif pressed(3):
            self.stop(1)
        elif pressed(2):
            self.request('manual')
        elif pressed(0):
            self.request('external')

    def service(self, name, response):
        if name == 'manual' and not self.joystick:
            response.message = 'Joystick disabled'
            return response
        if name in ('brake', 'free'):
            self.stop(0 if name == 'brake' else 1)
        else:
            self.request(name)
        response.success = True
        response.message = 'Requested ' + name
        return response

    def tick(self):
        now = time.monotonic()
        if ((self.joystick and now - self.joy_time > .5) or
                now - self.last_tick > .25):
            self.stop(0)
        self.last_tick = now
        # Motor output has one owner; multiple producers on an input are invalid.
        for topic in ['/cmd_vel', '/cmd_vel_teleop', '/cmd_vel_smoothed',
                      '/cmd_vel_selected', '/cmd_vel_safe', '/navigation_safety/mode']:
            if self.count_publishers(topic) > 1:
                self.stop(0)
        fresh = now - self.smooth_time < .3
        motor_ready = self.motors_online and now - self.motor_time < 1.2
        if self.mode == 2 and (not fresh or not motor_ready):
            self.stop(0)
        if self.pending is not None:
            self.target.publish(Twist())
            # Require zero samples after the ramp-down request has propagated.
            if fresh and motor_ready and now - self.switch_time >= .15 and self.zero_samples >= 3:
                self.source, self.pending = self.pending, None
                self.mode = 2
                self.accept_after = now
                self.commands.clear()
            elif now - self.switch_time > 10.:
                self.stop(0)
        elif self.mode == 2:
            stamp, cmd = self.commands.get(self.source, (-math.inf, Twist()))
            self.target.publish(cmd if now - stamp < .3 and stamp > self.accept_after
                                else Twist())
        else:
            self.target.publish(Twist())
        self.output.publish(self.smoothed if self.mode == 2 and fresh else Twist())
        self.lease.publish(UInt8(data=self.mode))
        self.status.publish(String(data=f'mode={self.mode} source={self.source} pending={self.pending}'))


def main():
    rclpy.init()
    node = CommandMux()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            node.stop(0)
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()

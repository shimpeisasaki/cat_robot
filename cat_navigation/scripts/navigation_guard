#!/usr/bin/env python3
"""Navigation-only sensor/TF monitor. Physical stop control lives in cat_bringup."""
import math
import time
import rclpy
from rclpy.node import Node
from rclpy.clock import Clock, ClockType
from rclpy.time import Time
from rclpy.qos import qos_profile_sensor_data
from nav_msgs.msg import Odometry
from sensor_msgs.msg import LaserScan
from std_msgs.msg import Bool, String
from action_msgs.srv import CancelGoal
from tf2_ros import Buffer, TransformListener


class NavigationGuard(Node):
    def __init__(self):
        super().__init__('navigation_guard')
        self.scan_max_age = self.declare_parameter('scan_max_age', .3).value
        self.scan_timeout = self.declare_parameter('scan_timeout', .5).value
        self.scan_frame = self.declare_parameter('scan_frame', 'laser').value
        if not all(math.isfinite(v) and v > 0 for v in (self.scan_max_age, self.scan_timeout)):
            raise ValueError('Scan age and timeout must be finite and positive')
        self.fresh, self.stamps = {}, {}
        self.buffer = Buffer()
        self.listener = TransformListener(self.buffer, self)
        self.ready = self.create_publisher(Bool, '/navigation/ready', 1)
        self.create_subscription(Odometry, '/odom', self.odom, qos_profile_sensor_data)
        self.create_subscription(LaserScan, '/scan', self.scan, qos_profile_sensor_data)
        self.create_subscription(String, '/base_safety/status', self.base_status, 1)
        self.cancel_clients = [self.create_client(CancelGoal, f'/{name}/_action/cancel_goal')
            for name in ('navigate_to_pose', 'navigate_through_poses', 'follow_waypoints',
                         'follow_path', 'spin', 'backup', 'wait', 'drive_on_heading', 'assisted_teleop')]
        self.cancel_futures = {}
        self.last_cancel = -math.inf
        self.create_timer(.05, self.tick, clock=Clock(clock_type=ClockType.STEADY_TIME))

    def base_status(self, msg):
        if msg.data.startswith('2: NAVIGATION') or time.monotonic()-self.last_cancel < .5:
            return
        self.last_cancel = time.monotonic()
        for client in self.cancel_clients:
            future = self.cancel_futures.get(client.srv_name)
            if client.service_is_ready() and (future is None or future.done()):
                self.cancel_futures[client.srv_name] = client.call_async(CancelGoal.Request())

    def header_ok(self, key, header, max_age=.5):
        t = header.stamp.sec + header.stamp.nanosec*1e-9
        now = self.get_clock().now().nanoseconds*1e-9
        if t <= 0 or not -.1 <= now-t <= max_age or t <= self.stamps.get(key, -math.inf):
            return False
        self.stamps[key] = t
        self.fresh[key] = time.monotonic()
        return True

    def odom(self, msg):
        p, q = msg.pose.pose.position, msg.pose.pose.orientation
        if (msg.header.frame_id == 'odom' and msg.child_frame_id == 'base_link' and
                all(math.isfinite(v) for v in (p.x, p.y, p.z, q.x, q.y, q.z, q.w)) and
                .9 < q.x*q.x+q.y*q.y+q.z*q.z+q.w*q.w < 1.1):
            self.header_ok('odom', msg.header)

    def scan(self, msg):
        if (msg.header.frame_id == self.scan_frame and
                any(math.isfinite(v) and msg.range_min <= v <= msg.range_max for v in msg.ranges)):
            self.header_ok('scan', msg.header, self.scan_max_age)

    def sensor_problem(self):
        now = time.monotonic()
        for key, limit in (('odom', .5), ('scan', self.scan_timeout)):
            if now-self.fresh.get(key, -math.inf) > limit:
                return key+' stale/missing/invalid'
        return None

    def tick(self):
        valid = self.sensor_problem() is None
        now = self.get_clock().now().nanoseconds*1e-9
        for parent, child, age in [('odom', 'base_link', .5), ('map', 'odom', 1.5)]:
            try:
                tf = self.buffer.lookup_transform(parent, child, Time())
                stamp = tf.header.stamp.sec + tf.header.stamp.nanosec*1e-9
                valid = valid and stamp > 0 and -.1 <= now-stamp <= age
            except Exception:
                valid = False
        publishers = self.get_publishers_info_by_topic('/cmd_vel_external')
        valid = valid and len(publishers) == 1 and publishers[0].node_name == 'collision_monitor'
        self.ready.publish(Bool(data=bool(valid)))


def main():
    rclpy.init()
    node = NavigationGuard()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
